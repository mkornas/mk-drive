{
  "name": "mk-drive-server",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "mk-drive API: locations, listings, streamed files. Fastify on Node 24, no build step.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "DRIVE_LOCATIONS_DIR=${DRIVE_LOCATIONS_DIR:-../data/locations} DRIVE_DATA_DIR=${DRIVE_DATA_DIR:-../data} node --watch src/index.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@mk-kit/auth": "^0.2.1",
    "archiver": "^8.0.0",
    "fastify": "^5.6.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.13.3",
    "jose": "^6.2.12",
    "typescript": "~6.0.2"
  }
}
